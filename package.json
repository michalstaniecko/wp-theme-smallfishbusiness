{
  "name": "smallfishbusiness",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build:vite": "vite build",
    "watch": "vite build --watch",
    "build:blocks": "wp-scripts build --source-path=src/blocks --output-path=themes/smallfishbusiness/blocks --webpack-copy-php",
    "build": "npm run build:vite && npm run build:blocks"
  },
  "dependencies": {
    "@wordpress/block-editor": "latest",
    "@wordpress/blocks": "latest",
    "@wordpress/i18n": "latest"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.0.0",
    "@wordpress/scripts": "^31.2.0",
    "tailwindcss": "^4.0.0",
    "vite": "^7.2.7"
  }
}

{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "800px",
      "wideSize": "1200px"
    },
    "spacing": {
      "units": ["px", "rem", "%"],
      "spacingScale": {
        "steps": 0
      },
      "spacingSizes": [
        { "name": "XS", "slug": "xs", "size": "0.5rem" },
        { "name": "SM", "slug": "sm", "size": "1rem" },
        { "name": "MD", "slug": "md", "size": "1.5rem" },
        { "name": "LG", "slug": "lg", "size": "2rem" },
        { "name": "XL", "slug": "xl", "size": "3rem" },
        { "name": "2XL", "slug": "2xl", "size": "4rem" }
      ]
    },
    "color": {
      "custom": false,
      "customGradient": false,
      "palette": [
        { "name": "Primary 50", "slug": "primary-50", "color": "#ecfeff" },
        { "name": "Primary 100", "slug": "primary-100", "color": "#cffafe" },
        { "name": "Primary 500", "slug": "primary-500", "color": "#06b6d4" },
        { "name": "Primary 600", "slug": "primary-600", "color": "#0097B2" },
        { "name": "Primary 700", "slug": "primary-700", "color": "#0e7490" },
        { "name": "Primary 800", "slug": "primary-800", "color": "#155e75" },
        { "name": "Secondary 500", "slug": "secondary-500", "color": "#b91c1c" },
        { "name": "Secondary 600", "slug": "secondary-600", "color": "#810000" },
        { "name": "Secondary 700", "slug": "secondary-700", "color": "#6b0000" },
        { "name": "Gray 50", "slug": "gray-50", "color": "#f9fafb" },
        { "name": "Gray 100", "slug": "gray-100", "color": "#f3f4f6" },
        { "name": "Gray 200", "slug": "gray-200", "color": "#e5e7eb" },
        { "name": "Gray 500", "slug": "gray-500", "color": "#6b7280" },
        { "name": "Gray 700", "slug": "gray-700", "color": "#374151" },
        { "name": "Gray 900", "slug": "gray-900", "color": "#111827" },
        { "name": "White", "slug": "white", "color": "#ffffff" },
        { "name": "Black", "slug": "black", "color": "#000000" }
      ]
    },
    "typography": {
      "customFontSize": false,
      "fontFamilies": [
        {
          "fontFamily": "'Montserrat', system-ui, sans-serif",
          "name": "Sans",
          "slug": "sans"
        },
        {
          "fontFamily": "'Merriweather', Georgia, serif",
          "name": "Serif",
          "slug": "serif"
        }
      ]
    },
    "blocks": {
      "core/button": {
        "border": {
          "radius": true
        }
      },
      "core/paragraph": {
        "spacing": {
          "margin": true
        }
      }
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--white)",
      "text": "var(--wp--preset--color--gray-900)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--sans)",
      "fontSize": "1rem",
      "lineHeight": "1.625"
    },
    "spacing": {
      "blockGap": "1.5rem"
    },
    "elements": {
      "link": {
        "typography": {
          "textDecoration": "none"
        }
      },
      "heading": {
        "typography": {
          "fontWeight": "500",
          "lineHeight": "1.25"
        },
        "color": {
          "text": "var(--wp--preset--color--gray-900)"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--primary-600)",
          "text": "var(--wp--preset--color--white)"
        },
        "border": {
          "radius": "0.5rem"
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--primary-700)"
          }
        }
      }
    },
    "blocks": {
      "core/quote": {
        "border": {
          "left": {
            "color": "var(--wp--preset--color--primary-600)",
            "width": "4px"
          }
        },
        "spacing": {
          "padding": {
            "left": "1.5rem"
          }
        },
        "typography": {
          "fontStyle": "italic"
        }
      },
      "core/code": {
        "color": {
          "background": "var(--wp--preset--color--gray-100)",
          "text": "var(--wp--preset--color--gray-900)"
        },
        "border": {
          "radius": "0.375rem"
        },
        "spacing": {
          "padding": "1rem"
        }
      },
      "core/separator": {
        "color": {
          "background": "var(--wp--preset--color--gray-200)"
        }
      },
      "core/post-title": {
        "spacing": {
          "margin": {
            "bottom": "2rem"
          }
        }
      }
    }
  }
}

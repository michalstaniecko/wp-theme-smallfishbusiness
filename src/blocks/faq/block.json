{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sfb/faq",
	"version": "1.0.0",
	"title": "FAQ",
	"category": "widgets",
	"icon": "editor-help",
	"description": "Frequently Asked Questions with accordion functionality",
	"keywords": ["faq", "accordion", "questions", "answers"],
	"supports": {
		"html": false,
		"anchor": true,
		"align": ["wide", "full"]
	},
	"attributes": {
		"title": {
			"type": "string",
			"default": "Frequently Asked Questions"
		},
		"showTitle": {
			"type": "boolean",
			"default": true
		},
		"defaultOpenIndex": {
			"type": "number",
			"default": 0
		}
	},
	"providesContext": {
		"sfb/faqId": "anchor"
	},
	"textdomain": "smallfishbusiness",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php",
	"viewScript": "file:./view.js"
}
